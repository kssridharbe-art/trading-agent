# Delta Exchange API Configuration
DELTA_API_URL=https://api.delta.exchange
# For Delta Exchange India, set:
# DELTA_API_URL=https://api.india.delta.exchange
# For Delta Testnet, set:
# DELTA_API_URL=https://testnet-api.delta.exchange

DELTA_WS_URL=wss://socket.delta.exchange
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Trading Instrument & Settings
TRADING_SYMBOL=BTCUSDT
TIMEFRAME=5m
INITIAL_CAPITAL=10000.0
MARGIN_ALLOCATION_PCT=0.70
LEVERAGE=10.0
EMA_METHOD=METHOD_C

# Database
DB_PATH=delta_trading.db
